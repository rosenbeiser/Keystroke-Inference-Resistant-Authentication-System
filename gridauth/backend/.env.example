# ============================================================
# .env.example — Copy to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# AES-256-GCM key for encrypting individual password characters.
# Generate with: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# In production replace this env-var mechanism with an HSM-backed key manager
# (e.g., AWS CloudHSM, Azure Key Vault, Google Cloud KMS).
# The EnvVarKeyManager class in app/crypto/key_manager.py has a single
# load_key() method — swap it for a cloud KMS implementation without
# changing any other code.
AES_KEY_B64=REPLACE_WITH_32_BYTE_BASE64_KEY

# SQLite database file path (relative to backend/)
DATABASE_URL=sqlite:///./gridauth.db

# Grid configuration defaults (all overridable)
GRID_TOTAL_NODES=10
GRID_REAL_NODES=8
GRID_GHOST_NODES=2
GRID_CHARS_PER_NODE=4

# Session expiry in seconds (default 5 minutes)
SESSION_EXPIRY_SECONDS=300

# Authenticated session token lifetime in seconds (default 1 hour)
AUTH_TOKEN_EXPIRY_SECONDS=3600

# Password policy
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128

# Rate limiting (requests per minute per IP)
RATE_LIMIT_REGISTER=5
RATE_LIMIT_SESSION=10
RATE_LIMIT_VERIFY=10
